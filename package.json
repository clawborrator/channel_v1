{
  "name": "clawborrator-mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "clawborrator channel — MCP server that connects Claude Code to a hub_v1",
  "main": "dist/index.js",
  "bin": {
    "clawborrator-mcp": "bin/clawborrator-mcp"
  },
  "scripts": {
