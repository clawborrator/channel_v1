{
  "name": "clawborrator-mcp",
  "version": "0.0.5",
  "type": "module",
  "description": "clawborrator channel for hub_v1 — MCP server that connects Claude Code to a hub over WebSocket, with hooks for activity capture and tools for cross-session routing.",
  "license": "MIT",
  "homepage": "https://github.com/clawborrator/channel_v1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clawborrator/channel_v1.git"
  },
  "bugs": {
    "url": "https://github.com/clawborrator/channel_v1/issues"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "clawborrator",
    "websocket",
    "remote",
    "ai",
    "agent",
    "hub-v1"
  ],
  "main": "dist/index.js",
  "bin": {
    "clawborrator-mcp": "bin/clawborrator-mcp"
  },
  "files": [
    "dist",
    "dist-hook",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:tsc && npm run build:hook",
    "build:tsc": "tsc -p tsconfig.json",
    "build:hook": "esbuild src/hook-entry.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-hook/clawborrator-tail.mjs --banner:js=\"#!/usr/bin/env node\"",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
